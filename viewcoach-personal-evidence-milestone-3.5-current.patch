+        <div>
+            <p class="eyebrow">Personal proof</p>
+            <h2 id="goal-evidence-heading">Evidence for this goal</h2>
+        </div>
+        <a href="{% url 'evidence:list' %}">Evidence library</a>
+    </div>
+
+    {% if goal_evidence_links %}
+    <div class="goal-evidence-list">
+        {% for link in goal_evidence_links %}
