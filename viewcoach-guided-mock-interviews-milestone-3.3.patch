+    display: grid;
+    width: 2rem;
+    height: 2rem;
+    flex-shrink: 0;
+    place-items: center;
+    border-radius: 50%;
+    color: #fff;
+    background: var(--vc-burgundy-dark);
+    font-weight: 750;
+}
+
+.interview-transcript > li > p {
+    color: var(--vc-muted);
+}
+
+.interview-response-notes {
+    padding: 1rem;
+    border-left: 2px solid var(--vc-border-strong);
+    background: #f2ede6;
+}
+
+.interview-response-notes p:last-child {
+    margin-bottom: 0;
+}
+
+.interview-transcript-links {
+    flex-wrap: wrap;
+    justify-content: space-between;
+    margin-top: 1rem;
+}
+
+.interview-transcript-links details {
+    flex: 1;
+}
+
+.interview-transcript-links summary {
+    cursor: pointer;
+    color: var(--vc-burgundy);
+    font-weight: 700;
+}
+
+
+@media (max-width: 48rem) {
+    .app-mobile-navigation {
+        grid-template-columns: repeat(6, 1fr);
+    }
+
+    .mobile-nav-link {
+        min-width: 0;
+        font-size: 0.68rem;
+    }
+}
+
+@media (max-width: 60rem) {
+    .interview-create-layout {
+        grid-template-columns: 1fr;
+    }
+
+    .interview-overview-grid {
+        grid-template-columns: repeat(2, minmax(0, 1fr));
+    }
+
+    .interview-overview-copy {
+        grid-column: 1 / -1;
+    }
+
+    .interview-assessment-options {
+        grid-template-columns: repeat(2, minmax(0, 1fr));
+    }
+}
+
+@media (max-width: 44rem) {
+    .interview-page-header,
+    .interview-summary-header,
+    .interview-session-header,
+    .interview-section-heading {
+        align-items: stretch;
+        flex-direction: column;
+    }
+
+    .interview-overview-grid,
+    .interview-card-grid,
+    .interview-score-grid {
+        grid-template-columns: 1fr;
+    }
+
+    .interview-overview-copy {
+        grid-column: auto;
+    }
+
+    .interview-history-row {
+        grid-template-columns: 1fr;
+    }
+
+    .interview-timer {
+        width: 100%;
+        text-align: left;
+    }
+
+    .interview-assessment-options {
+        grid-template-columns: 1fr;
+    }
+
+    .interview-summary-actions,
+    .interview-create-actions {
+        align-items: stretch;
+        flex-direction: column;
+    }
+
+    .interview-summary-actions .button,
+    .interview-create-actions .button {
+        text-align: center;
+    }
+
+    .interview-focus-list article,
+    .interview-transcript-heading {
+        align-items: flex-start;
+        flex-direction: column;
+    }
+}
diff --git a/static/js/interviews.js b/static/js/interviews.js
new file mode 100644
index 0000000000000000000000000000000000000000..9842101b3c1666134f8b431eedcdc29dd5ecfe80
--- /dev/null
+++ b/static/js/interviews.js
@@ -0,0 +1,31 @@
+(() => {
+    const timer = document.querySelector("[data-interview-timer]");
+    if (!timer) {
+        return;
+    }
+
+    const display = timer.querySelector("[data-timer-display]");
+    const startedAt = Date.parse(timer.dataset.startedAt);
+    const durationMinutes = Number(timer.dataset.durationMinutes);
+
+    if (!display || Number.isNaN(startedAt) || Number.isNaN(durationMinutes)) {
+        return;
+    }
+
+    const durationMilliseconds = durationMinutes * 60 * 1000;
+
+    const updateTimer = () => {
+        const elapsedMilliseconds = Date.now() - startedAt;
+        const remainingMilliseconds = durationMilliseconds - elapsedMilliseconds;
+        const isOvertime = remainingMilliseconds < 0;
+        const absoluteSeconds = Math.floor(Math.abs(remainingMilliseconds) / 1000);
+        const minutes = Math.floor(absoluteSeconds / 60);
+        const seconds = absoluteSeconds % 60;
+
+        display.textContent = `${isOvertime ? "+" : ""}${minutes}:${String(seconds).padStart(2, "0")}`;
+        timer.classList.toggle("is-overtime", isOvertime);
+    };
+
+    updateTimer();
+    window.setInterval(updateTimer, 1000);
+})();
