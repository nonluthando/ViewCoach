+{% extends "base.html" %}
+
+{% block title %}Review IBM course | ViewCoach{% endblock %}
+{% block body_class %}roadmap-source-page{% endblock %}
+
+{% block content %}
+<nav class="roadmap-breadcrumbs" aria-label="Breadcrumb">
+    <a href="{% url 'roadmaps:course_list' %}">Course roadmaps</a>
+    <span aria-hidden="true">/</span>
+    <a href="{% url 'roadmaps:ibm_course_import' %}">Import IBM</a>
+    <span aria-hidden="true">/</span>
+    <span>Review</span>
+</nav>
+
+<section class="topic-workspace-header">
+    <div>
+        <p class="eyebrow">Import preview</p>
+        <h1>{{ preview.title }}</h1>
+        <p>{{ preview.description }}</p>
+        {% if preview.duration_minutes %}
+            <p>{{ preview.duration_minutes }} estimated minutes</p>
+        {% endif %}
+    </div>
+</section>
+
+{% if existing %}
+    <section class="topic-workspace-panel">
+        <h2>Already imported</h2>
+        <a class="button"
+           href="{% url 'roadmaps:detail' existing.roadmap.slug %}">
+            Open existing roadmap
+        </a>
+    </section>
+{% else %}
+    <section class="topic-workspace-panel">
+        <p class="eyebrow">Check before importing</p>
+        <h2>Course details and outline</h2>
+        <p>
+            IBM public pages do not always expose every internal lesson.
+            Edit this outline so it matches what you see in your account.
+        </p>
+        <form method="post"
+              action="{% url 'roadmaps:ibm_course_confirm' %}"
+              novalidate>
+            {% csrf_token %}
+            {{ confirm_form.source_url }}
+            <div class="form-field">
+                {{ confirm_form.title.label_tag }}
+                {{ confirm_form.title }}
+                {{ confirm_form.title.errors }}
+            </div>
+            <div class="form-field">
+                {{ confirm_form.description.label_tag }}
+                {{ confirm_form.description }}
+                {{ confirm_form.description.errors }}
+            </div>
+            <div class="form-field">
+                {{ confirm_form.outline_text.label_tag }}
+                {{ confirm_form.outline_text }}
+                <p class="help-text">
+                    {{ confirm_form.outline_text.help_text }}
+                </p>
+                {{ confirm_form.outline_text.errors }}
+            </div>
+            <button class="button" type="submit">
+                Import course roadmap
+            </button>
+        </form>
+    </section>
+{% endif %}
+{% endblock %}
