diff --git a/static/css/visual-identity-v1.css b/static/css/visual-identity-v1.css
new file mode 100644
index 0000000..deecbee
--- /dev/null
+++ b/static/css/visual-identity-v1.css
@@ -0,0 +1,462 @@
+/*
+ * ViewCoach visual identity correction.
+ *
+ * This stylesheet is intentionally loaded after the existing application CSS.
+ * It preserves the current responsive layouts and behaviour while replacing
+ * the generic cobalt/glow/pill treatment with a flatter study-workbench style.
+ */
+
+:root {
+    --vc2-navy: #20282c;
+    --vc2-navy-soft: #2a3438;
+    --vc2-blue: #a84f2a;
+    --vc2-blue-dark: #7f361f;
+    --vc2-blue-soft: #f2e3da;
+    --vc2-surface: #fffdf8;
+    --vc2-canvas: #f3efe7;
+    --vc2-text: #252720;
+    --vc2-muted: #686a61;
+    --vc2-border: #d9d2c6;
+    --vc2-border-strong: #bdb4a5;
+    --vc2-success: #5f765d;
+    --vc2-success-soft: #edf1e9;
+    --vc2-warning: #9c742c;
+    --vc2-danger: #963c32;
+    --vc2-youtube: #ad4134;
+    --vc2-radius-sm: 0.25rem;
+    --vc2-radius: 0.45rem;
+    --vc2-radius-lg: 0.65rem;
+    --vc2-shadow: 0 1px 2px rgba(37, 39, 32, 0.05);
+}
+
+.app-body {
+    --vc-burgundy: var(--vc2-blue);
+    --vc-burgundy-dark: var(--vc2-blue-dark);
+    --vc-burgundy-soft: var(--vc2-blue-soft);
+    --vc-ivory: var(--vc2-canvas);
+    --vc-paper: var(--vc2-surface);
+    --vc-paper-strong: var(--vc2-surface);
+    --vc-ink: var(--vc2-text);
+    --vc-muted: var(--vc2-muted);
+    --vc-border: var(--vc2-border);
+    --vc-border-strong: var(--vc2-border-strong);
+    color: var(--vc2-text);
+    background: var(--vc2-canvas);
+}
+
+/* Flat actions: no glow, bounce or soft-SaaS treatment. */
+
+.app-body .button {
+    border-color: var(--vc2-blue-dark);
+    border-radius: var(--vc2-radius-sm);
+    color: #ffffff;
+    background: var(--vc2-blue);
+    box-shadow: none;
+    transition: border-color 120ms ease, background 120ms ease;
+}
+
+.app-body .button:hover {
+    border-color: #632815;
+    background: var(--vc2-blue-dark);
+    box-shadow: none;
+    transform: none;
+}
+
+.app-body .button:active {
+    transform: none;
+}
+
+.app-body .button-secondary {
+    border-color: var(--vc2-border-strong);
+    color: var(--vc2-text);
+    background: var(--vc2-surface);
+    box-shadow: none;
+}
+
+.app-body .button-secondary:hover {
+    border-color: var(--vc2-text);
+    color: var(--vc2-text);
+    background: #f7f2e9;
+}
+
+.app-body a,
+.app-body .eyebrow,
+.dashboard-v2-kicker,
+.source-page-kicker {
+    color: var(--vc2-blue-dark);
+}
+
+.app-body :focus-visible {
+    outline: 2px solid var(--vc2-blue);
+    outline-offset: 2px;
+}
+
+/* Shell and navigation. */
+
+.app-sidebar {
+    border-right: 1px solid #354044;
+    background: var(--vc2-navy);
+    box-shadow: none;
+}
+
+.app-brand-mark {
+    border: 1px solid rgba(255, 255, 255, 0.15);
+    border-radius: var(--vc2-radius-sm);
+    background: var(--vc2-blue);
+    box-shadow: none;
+}
+
+.app-nav-link {
+    border-radius: var(--vc2-radius-sm);
+}
+
+.app-nav-link.is-active {
+    padding-left: calc(0.75rem - 3px);
+    border-left: 3px solid #d48a63;
+    color: #ffffff;
+    background: rgba(255, 255, 255, 0.09);
+    box-shadow: none;
+}
+
+.app-nav-link.is-active:hover {
+    background: rgba(255, 255, 255, 0.12);
+}
+
+.app-topbar {
+    background: var(--vc2-surface);
+    backdrop-filter: none;
+}
+
+.app-topbar .app-account-trigger,
+.app-topbar .app-account-menu-desktop .app-account-panel,
+.app-account-panel {
+    border-radius: var(--vc2-radius);
+    box-shadow: none;
+}
+
+.app-topbar .app-account-avatar,
+.mobile-account-avatar {
+    background: #384247;
+}
+
+.app-main,
+.app-shell {
+    background: var(--vc2-canvas);
+}
+
+.app-mobile-navigation {
+    box-shadow: none;
+}
+
+.mobile-nav-link.is-active {
+    color: var(--vc2-blue-dark);
+}
+
+/* Shared surfaces: edges provide hierarchy; shadows no longer do. */
+
+.app-body .form-card,
+.app-body .empty-state,
+.app-body .filter-panel,
+.app-body .type-card,
+.app-body .question-card,
+.app-body .stat-card,
+.app-body .content-card,
+.app-body .practice-card,
+.app-body .reveal-workspace,
+.app-body .review-list-item,
+.app-body .history-item,
+.app-body .topic-workspace-panel,
+.app-body .topic-sidebar-panel,
+.dashboard-v2-stat,
+.dashboard-v2-card,
+.dashboard-v2-learning-source,
+.source-switcher > a,
+.source-roadmap-card,
+.youtube-detail-media,
+.youtube-detail-copy,
+.youtube-detail-progress,
+.youtube-video-outline,
+.youtube-player-panel {
+    border-color: var(--vc2-border);
+    border-radius: var(--vc2-radius);
+    background: var(--vc2-surface);
+    box-shadow: none;
+}
+
+.app-body .message {
+    border-radius: var(--vc2-radius-sm);
+    box-shadow: none;
+}
+
+.app-body input,
+.app-body textarea,
+.app-body select {
+    border-radius: var(--vc2-radius-sm);
+    background: var(--vc2-surface);
+}
+
+.app-body input:focus,
+.app-body textarea:focus,
+.app-body select:focus {
+    border-color: var(--vc2-blue);
+    outline: 2px solid rgba(168, 79, 42, 0.18);
+}
+
+/* Badges are labels, not floating pills. */
+
+.app-body .badge,
+.dashboard-v2-pill,
+.dashboard-v2-quick-links nav strong,
+.source-badge,
+.youtube-detail-meta span,
+.youtube-video-status {
+    border: 1px solid currentColor;
+    border-radius: var(--vc2-radius-sm);
+    box-shadow: none;
+}
+
+.app-body .badge-technical {
+    color: #76503b;
+    background: #f3e7de;
+}
+
+.app-body .badge-concept {
+    color: #4e684f;
+    background: #edf1e9;
+}
+
+.app-body .badge-behavioural {
+    color: #81601e;
+    background: #f5edda;
+}
+
+.app-body .badge-debug {
+    color: #8b3d35;
+    background: #f4e4e0;
+}
+
+.app-body .badge-neutral {
+    color: #5e625b;
+    background: #efede7;
+}
+
+/* Dashboard. */
+
+.dashboard-v2-header h1 {
+    color: var(--vc2-text);
+}
+
+.dashboard-v2-stat {
+    min-height: 7.5rem;
+}
+
+.dashboard-v2-stat strong {
+    font-size: 1.8rem;
+}
+
+.dashboard-v2-pill {
+    color: var(--vc2-muted);
+    background: #f2eee6;
+}
+
+.dashboard-v2-plan-focus {
+    border-color: #d9c8b6;
+    border-radius: var(--vc2-radius);
+    background: #f8f3eb;
+    box-shadow: none;
+}
+
+.dashboard-v2-plan-focus.is-complete {
+    border-color: #c9d2c3;
+    background: var(--vc2-success-soft);
+}
+
+.dashboard-v2-plan-icon,
+.dashboard-v2-source-icon.is-viewcoach {
+    border-radius: var(--vc2-radius-sm);
+    background: var(--vc2-blue);
+    box-shadow: none;
+}
+
+.dashboard-v2-source-icon.is-youtube {
+    border-radius: var(--vc2-radius-sm);
+    background: var(--vc2-youtube);
+    box-shadow: none;
+}
+
+.dashboard-v2-duration,
+.dashboard-v2-progress-value {
+    color: var(--vc2-blue-dark);
+}
+
+.dashboard-v2-learning-list > a:hover strong,
+.dashboard-v2-quick-links nav a:hover {
+    color: var(--vc2-blue-dark);
+}
+
+.dashboard-v2-readiness-ring {
+    box-shadow: inset 0 0 0 1px var(--vc2-border);
+    background:
+        radial-gradient(circle at center, var(--vc2-surface) 59%, transparent 60%),
+        conic-gradient(var(--vc2-blue) calc(var(--readiness) * 1%), #e1ddd4 0);
+}
+
+.dashboard-v2-quick-links nav strong {
+    color: var(--vc2-blue-dark);
+    background: var(--vc2-blue-soft);
+}
+
+/* Roadmap source catalogue and workspaces. */
+
+.source-switcher > a {
+    transition: border-color 120ms ease, background 120ms ease;
+}
+
+.source-switcher > a:hover,
+.source-switcher > a.is-active {
+    border-color: #b99683;
+    background: #faf5ed;
+}
+
+.source-switcher > a.is-active {
+    box-shadow: inset 3px 0 0 var(--vc2-blue);
+}
+
+.source-switcher-icon {
+    border-radius: var(--vc2-radius-sm);
+    box-shadow: none;
+}
+
+.source-switcher-icon.is-viewcoach {
+    background: var(--vc2-blue);
+}
+
+.source-roadmap-card {
+    transition: border-color 120ms ease, background 120ms ease;
+}
+
+.source-roadmap-card:hover {
+    border-color: #ad9f8d;
+    background: #fffaf2;
+    box-shadow: none;
+    transform: none;
+}
+
+.source-badge.is-viewcoach {
+    color: var(--vc2-blue-dark);
+    background: var(--vc2-blue-soft);
+}
+
+.source-roadmap-card h3 a:hover,
+.youtube-video-row-main:hover strong {
+    color: var(--vc2-blue-dark);
+}
+
+.source-roadmap-progress,
+.roadmap-progress-track {
+    border-radius: 2px;
+    background: #ded9cf;
+}
+
+.source-roadmap-progress > span,
+.roadmap-progress-track > span {
+    border-radius: 0;
+    background: var(--vc2-blue);
+}
+
+.source-empty-state {
+    border-radius: var(--vc2-radius);
+    background: #faf7f0;
+}
+
+.youtube-roadmap-thumbnail > span {
+    box-shadow: none;
+}
+
+.youtube-detail-meta span {
+    color: var(--vc2-muted);
+    background: #f1ede5;
+}
+
+.youtube-video-row img,
+.youtube-video-placeholder {
+    border-radius: var(--vc2-radius-sm);
+}
+
+.youtube-video-status {
+    color: var(--vc2-muted);
+    background: #efede7;
+}
+
+.youtube-video-row.is-complete .youtube-video-status {
+    color: var(--vc2-success);
+    background: var(--vc2-success-soft);
+}
+
+.youtube-video-row.is-progress .youtube-video-status {
+    color: var(--vc2-blue-dark);
+    background: var(--vc2-blue-soft);
+}
+
+/* Reduce rounded treatment inherited by older sections. */
+
+.app-body .roadmap-card,
+.app-body .roadmap-section,
+.app-body .planner-card,
+.app-body .interview-card,
+.app-body .goal-card,
+.app-body .evidence-card,
+.app-body .knowledge-card {
+    border-radius: var(--vc2-radius);
+    box-shadow: none;
+}
+
+.app-body .roadmap-card:hover,
+.app-body .planner-card:hover,
+.app-body .interview-card:hover,
+.app-body .goal-card:hover,
+.app-body .evidence-card:hover,
+.app-body .knowledge-card:hover {
+    box-shadow: none;
+    transform: none;
+}
+
+/* Keep responsive behaviour, but make the mobile shell equally flat. */
+
+@media (max-width: 48rem) {
+    .app-mobile-header,
+    .app-mobile-navigation {
+        background: var(--vc2-surface);
+        box-shadow: none;
+    }
+
+    .app-main {
+        background: var(--vc2-canvas);
+    }
+
+    .dashboard-v2-header h1,
+    .source-page-header h1 {
+        letter-spacing: -0.03em;
+    }
+
+    .dashboard-v2-card,
+    .dashboard-v2-learning-source,
+    .source-roadmap-card,
+    .youtube-detail-copy,
+    .youtube-detail-progress,
+    .youtube-video-outline,
+    .youtube-player-panel {
+        border-radius: var(--vc2-radius);
+    }
+}
+
+@media (prefers-reduced-motion: reduce) {
+    .app-body *,
+    .app-body *::before,
+    .app-body *::after {
+        scroll-behavior: auto !important;
+        transition-duration: 0.01ms !important;
+        animation-duration: 0.01ms !important;
+        animation-iteration-count: 1 !important;
+    }
+}
