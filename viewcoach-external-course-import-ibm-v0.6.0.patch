+
+<section class="form-card">
+    <p class="eyebrow">IBM SkillsBuild</p>
+    <h1>Import a public course page</h1>
+    <p class="lead">
+        ViewCoach extracts the public metadata and lets you correct the
+        outline before saving it.
+    </p>
+    <form method="post" novalidate>
+        {% csrf_token %}
+        {{ form.non_field_errors }}
+        <div class="form-field">
+            {{ form.course_url.label_tag }}
+            {{ form.course_url }}
+            {{ form.course_url.errors }}
