+++ b/templates/evidence/project_explanations.html
@@ -0,0 +1,114 @@
+{% extends "base.html" %}
+
+{% block title %}Project explanations | ViewCoach{% endblock %}
+{% block body_class %}interview-pack-page{% endblock %}
+
+{% block content %}
+<nav class="evidence-breadcrumbs" aria-label="Breadcrumb">
+    <a href="{% url 'evidence:interview_pack' %}">Interview Hub</a>
+    <span aria-hidden="true">/</span>
+    <span>Project explanations</span>
+</nav>
+
+<section class="evidence-page-header">
+    <div>
+        <p class="eyebrow">Project explanations</p>
+        <h1>Explain the work without scrambling for the words.</h1>
+        <p>
+            Keep the concise answer, the complete explanation and the technical deep dive
+            together for every project an interviewer may ask about.
+        </p>
+    </div>
+    <div class="evidence-header-actions">
+        <a class="button button-secondary" href="{% url 'evidence:interview_pack' %}">
+            Interview Hub
+        </a>
+        <a class="button" href="{% url 'evidence:create' %}">Add project</a>
+    </div>
+</section>
+
+{% if project_cards %}
+<section class="evidence-catalogue" aria-label="Project interview explanations">
+    {% for card in project_cards %}
+    <article class="evidence-card">
+        <div class="evidence-card-main">
+            <div class="evidence-card-meta">
+                <span>Project</span>
+                {% if card.project.role_or_context %}<span>{{ card.project.role_or_context }}</span>{% endif %}
+                <span>Updated {{ card.project.updated_at|date:"j M Y" }}</span>
+            </div>
+            <h2><a href="{% url 'evidence:detail' card.project.pk %}">{{ card.project.title }}</a></h2>
+
+            {% if card.explanation %}
+                {% if card.explanation.quick_pitch %}
+                <div class="evidence-record">
+                    <h3>30-second explanation</h3>
+                    {{ card.explanation.quick_pitch|linebreaks }}
+                </div>
+                {% endif %}
+                {% if card.explanation.two_minute_answer %}
+                <details class="evidence-add-panel">
+                    <summary>Two-minute explanation</summary>
+                    {{ card.explanation.two_minute_answer|linebreaks }}
+                </details>
+                {% endif %}
+                {% if card.explanation.has_deep_dive %}
+                <details class="evidence-add-panel">
+                    <summary>Technical deep dive</summary>
+                    {% if card.explanation.architecture %}<h4>Architecture and data flow</h4>{{ card.explanation.architecture|linebreaks }}{% endif %}
+                    {% if card.explanation.key_decisions %}<h4>Important decisions</h4>{{ card.explanation.key_decisions|linebreaks }}{% endif %}
+                    {% if card.explanation.difficult_bug %}<h4>Difficult bug or failure</h4>{{ card.explanation.difficult_bug|linebreaks }}{% endif %}
+                    {% if card.explanation.testing_and_verification %}<h4>Testing and verification</h4>{{ card.explanation.testing_and_verification|linebreaks }}{% endif %}
+                    {% if card.explanation.ai_use %}<h4>How I used AI</h4>{{ card.explanation.ai_use|linebreaks }}{% endif %}
+                    {% if card.explanation.tradeoffs %}<h4>Trade-offs</h4>{{ card.explanation.tradeoffs|linebreaks }}{% endif %}
+                    {% if card.explanation.improvements %}<h4>What I would improve</h4>{{ card.explanation.improvements|linebreaks }}{% endif %}
+                    {% if card.explanation.scaling %}<h4>How I would scale it</h4>{{ card.explanation.scaling|linebreaks }}{% endif %}
+                    {% if card.explanation.likely_follow_ups %}<h4>Likely follow-ups</h4>{{ card.explanation.likely_follow_ups|linebreaks }}{% endif %}
+                </details>
+                {% endif %}
+            {% else %}
+                <p class="muted">No interview explanation yet.</p>
+            {% endif %}
+
+            {% if card.project.technology_list %}
+            <div class="evidence-tag-row">
+                {% for technology in card.project.technology_list|slice:":6" %}
+                    <span>{{ technology }}</span>
+                {% endfor %}
+            </div>
+            {% endif %}
+
+            {% if card.goal_links %}
+            <details class="evidence-add-panel">
+                <summary>Role-specific framing</summary>
+                {% for link in card.goal_links %}
+                <article class="evidence-record">
+                    <h3>{{ link.goal.title }}</h3>
+                    <p><strong>{{ link.get_relevance_display }}</strong></p>
+                    {% if link.framing_notes %}
+                        {{ link.framing_notes|linebreaks }}
+                    {% else %}
+                        <p class="muted">No framing notes captured yet.</p>
+                    {% endif %}
+                </article>
+                {% endfor %}
+            </details>
+            {% endif %}
+        </div>
+        <div class="evidence-header-actions">
+            <a class="button button-secondary" href="{% url 'evidence:project_explanation_edit' card.project.pk %}">
+                {% if card.explanation %}Edit explanation{% else %}Build explanation{% endif %}
+            </a>
+        </div>
+    </article>
+    {% endfor %}
+</section>
+{% else %}
+<section class="evidence-empty-state">
+    <p class="eyebrow">No projects yet</p>
+    <h2>Add the projects you expect interviewers to ask about.</h2>
+    <p>Start with ScoreRent, ViewCoach or your strongest work example.</p>
+    <a class="button" href="{% url 'evidence:create' %}">Add first project</a>
+</section>
+{% endif %}
+{% endblock %}
