+
+.proofloop-evidence-layers small {
+    color: var(--pl-muted);
+    font-size: 0.62rem;
+    line-height: 1.45;
+}
+
+/* Resources */
+
+.proofloop-resource-counts {
+    display: grid;
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+    gap: 0.55rem;
+}
+
+.proofloop-resource-counts a {
+    min-width: 0;
+    display: grid;
+    gap: 0.25rem;
+    padding: 0.75rem;
+    border: 1px solid var(--pl-border);
+    border-radius: var(--pl-radius-small);
+    color: var(--pl-text);
+    background: var(--pl-surface-muted);
+    text-decoration: none;
+}
+
+.proofloop-resource-counts span {
+    overflow: hidden;
+    color: var(--pl-muted);
+    font-size: 0.61rem;
+    text-overflow: ellipsis;
+    white-space: nowrap;
+}
+
+.proofloop-resource-counts strong {
+    font-size: 1rem;
+}
+
+.proofloop-recent-questions {
+    display: grid;
+    gap: 0;
+    margin-top: 0.85rem;
+}
+
+.proofloop-recent-questions > p {
+    margin-bottom: 0.35rem;
+    color: var(--pl-muted);
+    font-size: 0.62rem;
+    font-weight: 800;
+    letter-spacing: 0.06em;
+    text-transform: uppercase;
+}
+
+.proofloop-recent-questions > a {
+    min-width: 0;
+    display: grid;
+    grid-template-columns: auto minmax(0, 1fr) auto;
+    align-items: center;
+    gap: 0.55rem;
+    padding: 0.58rem 0;
+    border-bottom: 1px solid var(--pl-border);
+    color: var(--pl-text);
+    text-decoration: none;
+}
+
+.proofloop-recent-questions > a:last-child {
+    border-bottom: 0;
+}
+
+.proofloop-recent-questions > a span {
+    padding: 0.25rem 0.35rem;
+    border-radius: 999px;
+    color: var(--pl-emerald-dark);
+    background: var(--pl-emerald-soft);
+    font-size: 0.52rem;
+    font-weight: 800;
+}
+
+.proofloop-recent-questions > a strong {
+    overflow: hidden;
+    font-size: 0.68rem;
+    text-overflow: ellipsis;
+    white-space: nowrap;
+}
+
+.proofloop-recent-questions time {
+    color: var(--pl-muted);
+    font-size: 0.59rem;
+}
+
+/* Calendar */
+
+.proofloop-calendar-nav {
+    display: flex;
+    gap: 0.35rem;
+}
+
+.proofloop-calendar-nav a {
+    width: 1.8rem;
+    height: 1.8rem;
+    display: grid;
+    place-items: center;
+    border: 1px solid var(--pl-border);
+    border-radius: var(--pl-radius-small);
+    color: var(--pl-text);
+    background: var(--pl-surface);
+    text-decoration: none;
+}
+
+.proofloop-calendar-grid {
+    display: grid;
+    grid-template-columns: repeat(7, minmax(0, 1fr));
+    gap: 0.28rem;
+}
+
+.proofloop-calendar-weekday {
+    display: grid;
+    place-items: center;
+    min-height: 1.5rem;
+    color: var(--pl-muted);
+    font-size: 0.54rem;
+    font-weight: 800;
+}
+
+.proofloop-calendar-day {
+    position: relative;
+    min-height: 2rem;
+    display: grid;
+    place-items: center;
+    border: 1px solid transparent;
+    border-radius: 0.35rem;
+    color: var(--pl-text);
+    font-size: 0.62rem;
+}
+
+.proofloop-calendar-day.is-muted {
+    color: #b4b8b5;
+}
+
+.proofloop-calendar-day.is-today {
+    border-color: var(--pl-emerald);
+    color: #ffffff;
+    background: var(--pl-emerald);
+    font-weight: 850;
+}
+
+.proofloop-calendar-day.has-interview::after,
+.proofloop-calendar-day.has-review::after {
+    content: "";
+    position: absolute;
+    right: 0.24rem;
+    bottom: 0.2rem;
+    width: 0.28rem;
+    height: 0.28rem;
+    border-radius: 999px;
+}
+
+.proofloop-calendar-day.has-interview::after {
+    background: var(--pl-amber);
+}
+
+.proofloop-calendar-day.has-review::after {
+    background: var(--pl-emerald);
+}
+
+.proofloop-calendar-legend {
+    display: flex;
+    gap: 0.8rem;
+    margin-top: 0.65rem;
+    color: var(--pl-muted);
+    font-size: 0.58rem;
+}
+
+.proofloop-calendar-legend span {
+    display: flex;
+    align-items: center;
+    gap: 0.32rem;
+}
+
+.proofloop-calendar-legend span::before {
+    content: "";
+    width: 0.36rem;
+    height: 0.36rem;
+    border-radius: 999px;
+}
+
+.proofloop-calendar-legend .is-interview::before {
+    background: var(--pl-amber);
+}
+
+.proofloop-calendar-legend .is-review::before {
+    background: var(--pl-emerald);
+}
+
+/* Tablet */
+
+@media (max-width: 88rem) {
+    .app-body .proofloop-shell-stages li:not(:last-child)::after {
+        width: 0.8rem;
+        margin-inline: 0.38rem;
+    }
+
+    .proofloop-command-hero {
+        grid-template-columns: minmax(0, 1fr) minmax(24rem, 0.85fr);
+    }
+}
+
+@media (max-width: 74rem) {
+    .app-body .app-shell {
+        grid-template-columns: 14.5rem minmax(0, 1fr);
+    }
+
+    .app-body .proofloop-shell-stages {
+        display: none;
+    }
+
+    .app-body .proofloop-shell-topbar {
+        grid-template-columns: minmax(0, 1fr) auto;
+    }
+
+    .proofloop-command-hero {
+        grid-template-columns: 1fr;
+    }
+
+    .proofloop-loop-panel {
+        border-top: 1px solid rgba(255, 255, 255, 0.09);
+        border-left: 0;
+    }
+
+    .proofloop-loop-map {
+        grid-template-columns: repeat(5, minmax(0, 1fr));
+        gap: 0.45rem;
+    }
+
+    .proofloop-loop-map li {
+        grid-template-columns: 1fr;
+        justify-items: center;
+        gap: 0.45rem;
+        min-height: auto;
+        text-align: center;
+    }
+
+    .proofloop-loop-map li:not(:last-child)::after {
+        top: 1.15rem;
+        right: -0.55rem;
+        bottom: auto;
+        left: calc(50% + 1.15rem);
+        width: calc(100% - 1.75rem);
+        height: 1px;
+    }
+
+    .proofloop-loop-map li > div {
+        padding: 0;
+    }
+
+    .proofloop-loop-map small {
+        display: none;
+    }
+
+    .proofloop-loop-illustration {
+        display: none;
+    }
+
+    .proofloop-signal-strip {
+        grid-template-columns: repeat(2, minmax(0, 1fr));
+    }
+
+    .proofloop-signal-strip > a:nth-child(3) {
+        border-left: 0;
+        border-top: 1px solid var(--pl-border);
+    }
+
+    .proofloop-signal-strip > a:nth-child(4) {
+        border-top: 1px solid var(--pl-border);
+    }
+
+    .proofloop-dashboard-grid {
+        grid-template-columns: repeat(8, minmax(0, 1fr));
+        grid-template-areas:
+            "plan plan plan plan plan readiness readiness readiness"
+            "journey journey journey journey journey upcoming upcoming upcoming"
+            "roadmaps roadmaps roadmaps roadmaps roadmaps calendar calendar calendar"
+            "evidence evidence evidence evidence resources resources resources resources";
+    }
+
+    .proofloop-roadmap-list {
+        grid-template-columns: 1fr;
+    }
+
+    .proofloop-evidence-layers {
+        grid-template-columns: 1fr;
+    }
+
+    .proofloop-evidence-layers a,
+    .proofloop-evidence-layers a:nth-child(2),
+    .proofloop-evidence-layers a:nth-child(3) {
+        min-height: 5.5rem;
+        transform: none;
+    }
+}
+
+/* Mobile */
+
+@media (max-width: 58rem) {
+    .app-body .app-shell {
+        display: block;
+        padding-bottom: 4.75rem;
+    }
+
+    .app-body .app-sidebar,
+    .app-body .app-topbar {
+        display: none;
+    }
+
+    .app-body .app-mobile-header {
+        position: sticky;
+        top: 0;
+        z-index: 30;
+        min-height: 4rem;
+        display: flex;
+        align-items: center;
+        justify-content: space-between;
+        padding: 0.65rem 1rem;
+        border-bottom: 1px solid var(--pl-border);
+        background: rgba(255, 253, 248, 0.96);
+        backdrop-filter: blur(14px);
+    }
+
+    .app-body .app-mobile-brand {
+        color: var(--pl-text);
+    }
+
+    .app-body .proofloop-workspace-main {
+        padding: 1rem;
+    }
+
+    .proofloop-dashboard-intro {
+        align-items: flex-start;
+    }
+
+    .proofloop-goal-chip {
+        display: none;
+    }
+
+    .proofloop-command-copy h2 {
+        font-size: clamp(2rem, 10vw, 3rem);
+    }
+
+    .proofloop-command-meta {
+        grid-template-columns: 1fr 1fr;
+        gap: 0.75rem;
+    }
+
+    .proofloop-command-meta div {
+        padding: 0;
+    }
+
+    .proofloop-command-meta div + div {
+        padding: 0;
+        border-left: 0;
+    }
+
+    .proofloop-command-meta div:last-child {
+        grid-column: 1 / -1;
+        padding-top: 0.7rem;
+        border-top: 1px solid rgba(255, 255, 255, 0.12);
+    }
+
+    .proofloop-loop-panel > header {
+        align-items: flex-start;
+    }
+
+    .proofloop-loop-state {
+        display: none;
+    }
+
+    .proofloop-loop-map {
+        overflow-x: auto;
+        grid-template-columns: repeat(5, minmax(5.6rem, 1fr));
+        padding-bottom: 0.35rem;
+    }
+
+    .proofloop-signal-strip {
+        grid-template-columns: 1fr;
+    }
+
+    .proofloop-signal-strip > a + a,
+    .proofloop-signal-strip > a:nth-child(3),
+    .proofloop-signal-strip > a:nth-child(4) {
+        border-top: 1px solid var(--pl-border);
+        border-left: 0;
+    }
+
+    .proofloop-dashboard-grid {
+        display: flex;
+        flex-direction: column;
+    }
+
+    .proofloop-plan-panel { order: 1; }
+    .proofloop-journey-panel { order: 2; }
+    .proofloop-roadmaps-panel { order: 3; }
+    .proofloop-readiness-panel { order: 4; }
+    .proofloop-upcoming-panel { order: 5; }
+    .proofloop-evidence-panel { order: 6; }
+    .proofloop-resources-panel { order: 7; }
+    .proofloop-calendar-panel { order: 8; }
+
+    .proofloop-panel {
+        padding: 1rem;
+    }
+
+    .proofloop-plan-list .dashboard-v3-plan-item {
+        grid-template-columns: 1.75rem 2rem minmax(0, 1fr) auto;
+        gap: 0.55rem;
+    }
+
+    .proofloop-plan-list .dashboard-v3-plan-duration {
+        display: none;
+    }
+
+    .proofloop-readiness-main {
+        grid-template-columns: 5.4rem minmax(0, 1fr);
+    }
+
+    .proofloop-readiness-ring {
+        width: 5.4rem;
+        height: 5.4rem;
+    }
+
+    .proofloop-readiness-signals,
+    .proofloop-resource-counts {
+        grid-template-columns: 1fr;
+    }
+
+    .proofloop-evidence-layers {
+        grid-template-columns: repeat(3, minmax(10rem, 1fr));
+        overflow-x: auto;
+        padding-bottom: 0.4rem;
+    }
+
+    .proofloop-evidence-layers a {
+        min-height: 7rem;
+    }
+}
+
+@media (max-width: 34rem) {
+    .proofloop-dashboard-intro {
+        display: grid;
+        grid-template-columns: minmax(0, 1fr) auto;
+        gap: 0.85rem;
+    }
+
+    .proofloop-dashboard-intro-copy {
+        min-width: 0;
+    }
+
+    .proofloop-dashboard-intro h1 {
+        font-size: 1.65rem;
+    }
+
+    .proofloop-dashboard-intro-copy > p:last-child {
+        font-size: 0.78rem;
+    }
+
+    .proofloop-icon-button {
+        width: 2.45rem;
+        height: 2.45rem;
+    }
+
+    .proofloop-dashboard-intro-actions {
+        align-self: start;
+    }
+
+    .proofloop-command-copy,
+    .proofloop-loop-panel {
+        padding: 1.15rem;
+    }
+
+    .proofloop-command-label-row {
+        display: block;
+    }
+
+    .proofloop-command-label-row > span {
+        display: block;
+        margin-top: 0.25rem;
+    }
+
+    .proofloop-command-actions {
+        display: grid;
+    }
+
+    .proofloop-command-actions .button {
+        width: 100%;
+    }
+
+    .proofloop-panel-header {
+        align-items: flex-start;
+    }
+
+    .proofloop-panel-footer {
+        display: grid;
+        grid-template-columns: 1fr 1fr;
+        gap: 0.65rem;
+    }
+
+    .proofloop-panel-footer a {
+        grid-column: 1 / -1;
+        margin-left: 0;
+    }
+
+    .proofloop-plan-list .dashboard-v3-plan-item {
+        grid-template-columns: 1.6rem 1.9rem minmax(0, 1fr);
+    }
+
+    .proofloop-plan-list .dashboard-v3-plan-action,
+    .proofloop-plan-list .dashboard-v3-plan-done {
+        grid-column: 3;
+        justify-self: start;
+        margin-top: 0.2rem;
+    }
+
+    .proofloop-journey-list .dashboard-v3-journey-step {
+        grid-template-columns: 2.15rem minmax(0, 1fr);
+    }
+
+    .proofloop-journey-list .dashboard-v3-journey-status {
+        grid-column: 2;
+    }
+
+    .proofloop-readiness-main {
+        grid-template-columns: 1fr;
+        justify-items: start;
+    }
+
+    .proofloop-readiness-signals {
+        grid-template-columns: 1fr;
+    }
+}
+
+@media (prefers-reduced-motion: reduce) {
+    .proofloop-dashboard *,
+    .proofloop-navigation * {
+        scroll-behavior: auto !important;
+        transition: none !important;
+    }
+}
