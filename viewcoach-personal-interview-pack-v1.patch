+@login_required
+def interview_pack(request):
+    projects = (
+        _owned_evidence(request.user)
+        .filter(source_type=EvidenceItem.SourceType.PROJECT)
+        .prefetch_related("goal_links__goal")
+        .order_by("-updated_at", "title")
+    )
