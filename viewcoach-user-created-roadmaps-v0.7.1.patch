+        roadmap=roadmap,
+        provider=ExternalCourseRoadmap.Provider.OTHER,
+        source_url="https://example.com/course",
+    )
+    client.force_login(user)
+
+    list_response = client.get(reverse("roadmaps:custom_list"))
+    manage_response = client.get(
