diff --git a/templates/core/proofloop_dashboard.html b/templates/core/proofloop_dashboard.html
new file mode 100644
index 0000000..200d6d8
--- /dev/null
+++ b/templates/core/proofloop_dashboard.html
@@ -0,0 +1,407 @@
+{% extends "base.html" %}
+
+{% block title %}Dashboard | ProofLoop{% endblock %}
+{% block body_class %}dashboard-v3-page proofloop-workspace-page{% endblock %}
+{% block main_class %}dashboard-v3-main proofloop-workspace-main{% endblock %}
+
+{% block content %}
+<section class="dashboard-v3 proofloop-dashboard">
+    <header class="proofloop-dashboard-intro">
+        <div class="proofloop-dashboard-intro-copy">
+            <p class="proofloop-kicker">Preparation command centre</p>
+            <h1>{{ greeting }}{% if user.first_name %}, {{ user.first_name }}{% endif %}</h1>
+            <p>
+                {% if primary_goal %}
+                    Stay consistent with <strong>{{ primary_goal.title }}</strong> for {{ primary_goal.role_title }}.
+                {% elif need_focus %}
+                    {{ need_focus.description }}
+                {% else %}
+                    Build skills, practise recall and turn your experience into confident answers.
+                {% endif %}
+            </p>
+        </div>
+        <div class="proofloop-dashboard-intro-actions" aria-label="Dashboard shortcuts">
+            {% if primary_goal %}
+                <a class="proofloop-goal-chip" href="{{ primary_goal.get_absolute_url }}">
+                    <span>Primary goal</span>
+                    <strong>{{ primary_goal.role_title }}</strong>
+                </a>
+            {% endif %}
+            <a class="proofloop-icon-button" href="{% url 'questions:list' %}" aria-label="Search question bank">
+                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6"></circle><path d="m16 16 4 4"></path></svg>
+            </a>
+            <a class="proofloop-icon-button" href="{% url 'reviews:queue' %}" aria-label="Open due reviews">
+                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9a6 6 0 0 1 12 0c0 7 3 7 3 8H3c0-1 3-1 3-8"></path><path d="M10 21h4"></path></svg>
+                {% if due_review_count %}<span>{{ due_review_count }}</span>{% endif %}
+            </a>
+        </div>
+    </header>
+
+    <section class="proofloop-command-hero" aria-labelledby="proofloop-next-action-heading">
+        <div class="proofloop-command-copy">
+            <div class="proofloop-command-label-row">
+                <p class="proofloop-kicker">Continue preparing</p>
+                <span>{{ today_plan.progress_percent }}% of today complete</span>
+            </div>
+            <h2 id="proofloop-next-action-heading">
+                {% if today_plan.current %}
+                    {{ today_plan.current.title }}
+                {% elif today_plan.is_complete %}
+                    Today’s preparation loop is complete
+                {% else %}
+                    Build today’s preparation plan
+                {% endif %}
+            </h2>
+            <p class="proofloop-command-summary">
+                {% if today_plan.current %}
+                    ProofLoop selected this from <strong>{{ today_plan.focus_label }}</strong> because it is the most useful next block for your current preparation state.
+                {% elif today_plan.is_complete %}
+                    You have closed the loop for today. Review the work or prepare tomorrow’s next action.
+                {% else %}
+                    Create a time-boxed plan from due reviews, focused roadmaps, evidence gaps and interview priorities.
+                {% endif %}
+            </p>
+            <div class="proofloop-command-progress" role="progressbar" aria-label="Today’s plan" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ today_plan.progress_percent }}">
+                <span style="--proofloop-progress: {{ today_plan.progress_percent }}%;"></span>
+            </div>
+            <dl class="proofloop-command-meta">
+                <div><dt>Time remaining</dt><dd>{{ today_plan.remaining_minutes }} min</dd></div>
+                <div><dt>Blocks remaining</dt><dd>{{ today_plan.remaining_count }}</dd></div>
+                <div><dt>Current streak</dt><dd>{{ streak.current }} day{{ streak.current|pluralize }}</dd></div>
+            </dl>
+            <div class="proofloop-command-actions">
+                <a class="button" href="{% url 'planner:today' %}">
+                    {% if today_plan.is_complete %}Review today’s plan{% elif today_plan.current %}Resume preparation{% else %}Build today’s plan{% endif %}
+                </a>
+                <a class="button button-secondary" href="{% url 'planner:today' %}">View full plan</a>
+            </div>
+        </div>
+
+        <div class="proofloop-loop-panel">
+            <header>
+                <div>
+                    <p class="proofloop-kicker">Your preparation loop</p>
+                    <h2>Plan → Learn → Retain → Prove → Rehearse</h2>
+                </div>
+                <span class="proofloop-loop-state">
+                    {% if readiness %}{{ readiness.label }}{% else %}Building foundations{% endif %}
+                </span>
+            </header>
+            <ol class="proofloop-loop-map" aria-label="Preparation loop status">
+                <li class="{% if today_plan.total_count %}is-complete{% else %}is-current{% endif %}">
+                    <span class="proofloop-loop-node">01</span>
+                    <div><strong>Plan</strong><small>{{ today_plan.total_count }} block{{ today_plan.total_count|pluralize }} selected</small></div>
+                </li>
+                <li class="{% if learning_journey and learning_journey.percentage >= 100 %}is-complete{% elif learning_journey %}is-current{% endif %}">
+                    <span class="proofloop-loop-node">02</span>
+                    <div><strong>Learn</strong><small>{% if learning_journey %}{{ learning_journey.percentage }}% through current path{% else %}Choose a focused roadmap{% endif %}</small></div>
+                </li>
+                <li class="{% if due_review_count == 0 and question_count %}is-complete{% elif due_review_count %}is-current{% endif %}">
