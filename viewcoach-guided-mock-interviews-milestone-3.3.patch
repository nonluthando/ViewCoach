diff --git a/templates/interviews/interview_create.html b/templates/interviews/interview_create.html
new file mode 100644
index 0000000000000000000000000000000000000000..24cdbd1616eeb409e1afac9a2741483b6f899696
--- /dev/null
+++ b/templates/interviews/interview_create.html
@@ -0,0 +1,54 @@
+{% extends "base.html" %}
+
+{% block title %}Create mock interview | ViewCoach{% endblock %}
+{% block body_class %}interview-create-page{% endblock %}
+
+{% block content %}
+<section class="interview-create-layout">
+    <div class="interview-create-intro">
+        <a class="interview-back-link" href="{% url 'interviews:list' %}">← Mock interviews</a>
+        <p class="eyebrow">New session</p>
+        <h1>Choose the pressure you want to practise.</h1>
+        <p>
+            ViewCoach builds the session from questions you can access. It favours
+            due reviews and questions that were recently rated Again or Hard.
+        </p>
+
+        <div class="interview-selection-note">
+            <strong>Mixed sessions balance four formats</strong>
+            <p>Technical, conceptual, behavioural and repository-debugging questions.</p>
+        </div>
+    </div>
+
+    <form class="interview-create-card" method="post">
+        {% csrf_token %}
+
+        {% if form.non_field_errors %}
+            <div class="form-errors">{{ form.non_field_errors }}</div>
+        {% endif %}
+
+        <div class="form-field">
+            <label for="{{ form.focus.id_for_label }}">{{ form.focus.label }}</label>
+            {{ form.focus }}
+            {% if form.focus.help_text %}<p class="help-text">{{ form.focus.help_text }}</p>{% endif %}
+            {{ form.focus.errors }}
+        </div>
+
+        <div class="form-field">
+            <label for="{{ form.duration_minutes.id_for_label }}">
+                {{ form.duration_minutes.label }}
+            </label>
+            {{ form.duration_minutes }}
+            {% if form.duration_minutes.help_text %}
+                <p class="help-text">{{ form.duration_minutes.help_text }}</p>
+            {% endif %}
+            {{ form.duration_minutes.errors }}
+        </div>
+
+        <div class="interview-create-actions">
+            <button class="button" type="submit">Build my session</button>
+            <a href="{% url 'interviews:list' %}">Cancel</a>
+        </div>
+    </form>
+</section>
+{% endblock %}
diff --git a/templates/interviews/interview_list.html b/templates/interviews/interview_list.html
new file mode 100644
index 0000000000000000000000000000000000000000..5c295eb783995315b01c81577feaf6fb9ceefddd
--- /dev/null
+++ b/templates/interviews/interview_list.html
@@ -0,0 +1,98 @@
+{% extends "base.html" %}
+
+{% block title %}Mock interviews | ViewCoach{% endblock %}
+{% block body_class %}interviews-page{% endblock %}
+
+{% block content %}
+<section class="interview-page-header">
+    <div>
+        <p class="eyebrow">Mock interviews</p>
+        <h1>Practise explaining under pressure.</h1>
+        <p>
+            Run a timed session from the question bank, assess each answer honestly,
+            and leave with a focused debrief.
+        </p>
+    </div>
+    <a class="button" href="{% url 'interviews:create' %}">Start a mock interview</a>
+</section>
+
+<section class="interview-overview-grid" aria-label="Mock interview overview">
+    <article class="interview-overview-card">
+        <span class="interview-overview-number">{{ completed_count }}</span>
+        <span>completed sessions</span>
+    </article>
+    <article class="interview-overview-card">
+        <span class="interview-overview-number">{{ active_interviews|length }}</span>
+        <span>ready or in progress</span>
+    </article>
+    <article class="interview-overview-card interview-overview-copy">
+        <strong>Deterministic question selection</strong>
+        <span>Due reviews and recent weak answers are prioritised first.</span>
+    </article>
+</section>
+
+{% if active_interviews %}
+<section class="interview-section" aria-labelledby="active-interviews-heading">
+    <div class="interview-section-heading">
+        <div>
+            <p class="eyebrow">Continue</p>
+            <h2 id="active-interviews-heading">Active sessions</h2>
+        </div>
+    </div>
+
+    <div class="interview-card-grid">
+        {% for interview in active_interviews %}
+            <article class="interview-card">
+                <div class="interview-card-meta">
+                    <span>{{ interview.get_focus_display }}</span>
+                    <span>{{ interview.duration_minutes }} min</span>
+                </div>
+                <h3>{{ interview.question_count }}-question session</h3>
+                <p>
+                    {{ interview.answered_count }} answered ·
+                    {{ interview.completion_percent }}% complete
+                </p>
+                <div class="interview-progress-track" aria-hidden="true">
+                    <span style="width: {{ interview.completion_percent }}%"></span>
+                </div>
+                <a class="button button-secondary" href="{% url 'interviews:session' interview.pk %}">
+                    {% if interview.status == "READY" %}Begin session{% else %}Resume session{% endif %}
+                </a>
+            </article>
+        {% endfor %}
+    </div>
+</section>
+{% endif %}
+
+<section class="interview-section" aria-labelledby="recent-interviews-heading">
+    <div class="interview-section-heading">
+        <div>
+            <p class="eyebrow">History</p>
+            <h2 id="recent-interviews-heading">Recent sessions</h2>
+        </div>
+    </div>
+
+    {% if completed_interviews %}
+        <div class="interview-history-list">
+            {% for interview in completed_interviews %}
+                <a class="interview-history-row" href="{% url 'interviews:summary' interview.pk %}">
+                    <span>
+                        <strong>{{ interview.get_focus_display }}</strong>
+                        <small>{{ interview.created_at|date:"j M Y · H:i" }}</small>
+                    </span>
+                    <span>{{ interview.answered_count }}/{{ interview.question_count }} answered</span>
+                    <span class="interview-status interview-status-{{ interview.status|lower }}">
+                        {{ interview.get_status_display }}
+                    </span>
+                </a>
+            {% endfor %}
+        </div>
+    {% else %}
+        <div class="interview-empty-state">
+            <h3>No mock interviews yet</h3>
+            <p>Start with a 20-minute session. The aim is a useful baseline, not perfection.</p>
+            <a class="button" href="{% url 'interviews:create' %}">Create first session</a>
+        </div>
+    {% endif %}
+</section>
+{% endblock %}
diff --git a/templates/interviews/interview_session.html b/templates/interviews/interview_session.html
new file mode 100644
index 0000000000000000000000000000000000000000..1c851bd89ddb8ba9a12adfb7e423d7961459df5d
--- /dev/null
+++ b/templates/interviews/interview_session.html
@@ -0,0 +1,113 @@
+{% extends "base.html" %}
+{% load static %}
+
+{% block title %}Mock interview | ViewCoach{% endblock %}
+{% block body_class %}interview-session-page{% endblock %}
+
+{% block content %}
+<section
+    class="interview-session-shell"
+    data-interview-timer
+    data-started-at="{{ interview.started_at|date:'c' }}"
+    data-duration-minutes="{{ interview.duration_minutes }}"
+>
+    <header class="interview-session-header">
+        <div>
+            <p class="eyebrow">{{ interview.get_focus_display }}</p>
+            <h1>Question {{ item.position }} of {{ interview.question_count }}</h1>
+        </div>
+        <div class="interview-timer" aria-live="polite">
+            <span>Time remaining</span>
+            <strong data-timer-display>{{ interview.duration_minutes }}:00</strong>
+        </div>
+    </header>
+
+    <div class="interview-progress">
+        <div class="interview-progress-copy">
+            <span>{{ answered_count }} answered</span>
+            <span>{{ interview.completion_percent }}%</span>
+        </div>
+        <div class="interview-progress-track" aria-hidden="true">
+            <span style="width: {{ interview.completion_percent }}%"></span>
+        </div>
+    </div>
+
+    <article class="interview-question-panel">
+        <div class="interview-question-meta">
+            <span class="badge badge-{{ item.question_type|lower }}">
+                {{ item.get_question_type_display }}
+            </span>
+            {% if item.difficulty %}
+                <span>{{ item.get_difficulty_display }}</span>
+            {% endif %}
+        </div>
+        <h2>{{ item.question_title }}</h2>
+        <div class="interview-prompt">{{ item.prompt_snapshot|linebreaks }}</div>
+    </article>
+
+    {% if item.guidance_snapshot %}
+        <details class="interview-reveal">
+            <summary>Use a prompt</summary>
+            <div>{{ item.guidance_snapshot|linebreaks }}</div>
+        </details>
+    {% endif %}
+
+    {% if item.answer_snapshot %}
+        <details class="interview-reveal interview-answer-reveal">
+            <summary>Reveal reference answer</summary>
+            <div>{{ item.answer_snapshot|linebreaks }}</div>
+        </details>
+    {% endif %}
+
+    <form
+        class="interview-response-card"
+        method="post"
+        action="{% url 'interviews:submit' interview.pk item.pk %}"
+    >
+        {% csrf_token %}
+        <div class="form-field">
+            <label for="{{ form.response_notes.id_for_label }}">
+                {{ form.response_notes.label }}
+            </label>
+            {{ form.response_notes }}
+            <p class="help-text">
+                These notes stay with the session debrief. They do not change the question bank.
+            </p>
+        </div>
+
+        <fieldset class="interview-assessment-fieldset">
+            <legend>{{ form.assessment.label }}</legend>
+            <div class="interview-assessment-options">
+                {% for choice in form.assessment %}
+                    <label class="interview-assessment-option">
+                        {{ choice.tag }}
+                        <span>{{ choice.choice_label }}</span>
+                    </label>
+                {% endfor %}
+            </div>
+            {{ form.assessment.errors }}
+        </fieldset>
+
+        <div class="interview-session-actions">
+            <button class="button" type="submit">
+                {% if item.position == interview.question_count %}
+                    Finish and view debrief
+                {% else %}
+                    Save and continue
+                {% endif %}
+            </button>
+        </div>
+    </form>
+
+    <form
+        class="interview-end-form"
+        method="post"
+        action="{% url 'interviews:abandon' interview.pk %}"
+    >
+        {% csrf_token %}
+        <button class="link-button danger-link" type="submit">End session early</button>
+    </form>
+</section>
+
+<script src="{% static 'js/interviews.js' %}" defer></script>
+{% endblock %}
diff --git a/templates/interviews/interview_summary.html b/templates/interviews/interview_summary.html
new file mode 100644
index 0000000000000000000000000000000000000000..514f36fed84d545af8294dd4367c15b6bfc8eda2
--- /dev/null
+++ b/templates/interviews/interview_summary.html
@@ -0,0 +1,123 @@
+{% extends "base.html" %}
+
+{% block title %}Mock interview debrief | ViewCoach{% endblock %}
+{% block body_class %}interview-summary-page{% endblock %}
+
+{% block content %}
+<section class="interview-summary-header">
+    <div>
+        <p class="eyebrow">Session debrief</p>
+        <h1>
+            {% if interview.status == "COMPLETED" %}
+                Mock interview complete.
+            {% else %}
+                Session saved.
+            {% endif %}
+        </h1>
+        <p>
+            {{ interview.get_focus_display }} · {{ interview.duration_minutes }}-minute plan ·
+            {{ interview.elapsed_minutes }} minute{{ interview.elapsed_minutes|pluralize }} elapsed
+        </p>
+    </div>
+    <div class="interview-summary-actions">
+        <a class="button" href="{% url 'interviews:create' %}">Start another</a>
+        <a href="{% url 'interviews:list' %}">All sessions</a>
+    </div>
+</section>
+
+<section class="interview-score-grid" aria-label="Answer assessment totals">
+    <article>
+        <strong>{{ confident_count }}</strong>
+        <span>Confident</span>
+    </article>
+    <article>
+        <strong>{{ partial_count }}</strong>
+        <span>Partly confident</span>
+    </article>
+    <article>
+        <strong>{{ struggled_count }}</strong>
+        <span>Struggled</span>
+    </article>
+    <article>
+        <strong>{{ skipped_count }}</strong>
+        <span>Skipped</span>
+    </article>
+</section>
+
+{% if weak_items %}
+<section class="interview-debrief-section interview-focus-section">
+    <div class="interview-section-heading">
+        <div>
+            <p class="eyebrow">Next focus</p>
+            <h2>Return to these questions</h2>
+        </div>
+    </div>
+    <div class="interview-focus-list">
+        {% for item in weak_items %}
+            <article>
+                <div>
+                    <span class="badge badge-{{ item.question_type|lower }}">
+                        {{ item.get_question_type_display }}
+                    </span>
+                    <h3>{{ item.question_title }}</h3>
+                    <p>{{ item.get_assessment_display }}</p>
+                </div>
+                {% if item.question_id %}
+                    <a href="{{ item.question_url }}">Open question</a>
+                {% endif %}
+            </article>
+        {% endfor %}
+    </div>
+</section>
+{% endif %}
+
+<section class="interview-debrief-section" aria-labelledby="answer-review-heading">
+    <div class="interview-section-heading">
+        <div>
+            <p class="eyebrow">Answer review</p>
+            <h2 id="answer-review-heading">Session transcript</h2>
+        </div>
+    </div>
+
+    <ol class="interview-transcript">
+        {% for item in items %}
+            <li>
+                <div class="interview-transcript-heading">
+                    <div>
+                        <span class="interview-transcript-number">{{ item.position }}</span>
+                        <h3>{{ item.question_title }}</h3>
+                    </div>
+                    {% if item.assessment %}
+                        <span class="interview-assessment-result interview-result-{{ item.assessment|lower }}">
+                            {{ item.get_assessment_display }}
+                        </span>
+                    {% else %}
+                        <span class="interview-assessment-result">Not answered</span>
+                    {% endif %}
+                </div>
+
+                <p>{{ item.prompt_snapshot|truncatewords:35 }}</p>
+
+                {% if item.response_notes %}
+                    <div class="interview-response-notes">
+                        <strong>Your notes</strong>
+                        {{ item.response_notes|linebreaks }}
+                    </div>
+                {% endif %}
+
+                <div class="interview-transcript-links">
+                    {% if item.answer_snapshot %}
+                        <details>
+                            <summary>Reference answer</summary>
+                            <div>{{ item.answer_snapshot|linebreaks }}</div>
+                        </details>
+                    {% endif %}
+                    {% if item.question_id %}
+                        <a href="{{ item.question_url }}">Open in question bank</a>
+                    {% endif %}
+                </div>
+            </li>
+        {% endfor %}
+    </ol>
+</section>
+{% endblock %}
