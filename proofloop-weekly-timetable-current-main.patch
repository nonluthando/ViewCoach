diff --git a/apps/planner/models.py b/apps/planner/models.py
index 2b705ad19b925ef12913d484f072a6cccd029c02..aebc6331f5abecbb51d296bd00967ecb816197df 100644
--- a/apps/planner/models.py
+++ b/apps/planner/models.py
@@ -1,4 +1,5 @@
 from django.conf import settings
+from django.core.exceptions import ValidationError
 from django.db import models
 from django.urls import reverse
 from django.utils import timezone
@@ -206,3 +207,159 @@ class StudySession(models.Model):
 
     def __str__(self):
         return f"Session for {self.plan}"
+
+class WeeklyTimetable(models.Model):
+    user = models.OneToOneField(
+        settings.AUTH_USER_MODEL,
+        on_delete=models.CASCADE,
+        related_name="weekly_timetable",
+    )
+    sessions_per_day = models.PositiveSmallIntegerField(default=0)
+    created_at = models.DateTimeField(auto_now_add=True)
+    updated_at = models.DateTimeField(auto_now=True)
+
+    class Meta:
+        constraints = [
+            models.CheckConstraint(
+                condition=models.Q(
+                    sessions_per_day__gte=0,
+                    sessions_per_day__lte=16,
+                ),
+                name="weekly_tt_sessions_range",
+            )
+        ]
+
+    @property
+    def is_configured(self):
+        return self.sessions_per_day > 0
+
+    @property
+    def session_numbers(self):
+        return range(1, self.sessions_per_day + 1)
+
+    def __str__(self):
+        return f"{self.user} · {self.sessions_per_day} sessions per day"
+
+
+class WeeklyTimetableBlock(models.Model):
+    class Weekday(models.IntegerChoices):
+        MONDAY = 0, "Monday"
+        TUESDAY = 1, "Tuesday"
+        WEDNESDAY = 2, "Wednesday"
+        THURSDAY = 3, "Thursday"
+        FRIDAY = 4, "Friday"
+        SATURDAY = 5, "Saturday"
+        SUNDAY = 6, "Sunday"
+
+    timetable = models.ForeignKey(
+        WeeklyTimetable,
+        on_delete=models.CASCADE,
+        related_name="blocks",
+    )
+    weekday = models.PositiveSmallIntegerField(choices=Weekday.choices)
+    session_number = models.PositiveSmallIntegerField()
+    title = models.CharField(max_length=120)
+    description = models.TextField(blank=True)
+    created_at = models.DateTimeField(auto_now_add=True)
+    updated_at = models.DateTimeField(auto_now=True)
+
+    class Meta:
+        ordering = ("weekday", "session_number", "pk")
+        constraints = [
+            models.UniqueConstraint(
+                fields=("timetable", "weekday", "session_number"),
+                name="weekly_tt_unique_slot",
+            ),
+            models.CheckConstraint(
+                condition=models.Q(weekday__gte=0, weekday__lte=6),
+                name="weekly_tt_day_range",
+            ),
+            models.CheckConstraint(
+                condition=models.Q(session_number__gte=1),
+                name="weekly_tt_session_positive",
+            ),
+        ]
+        indexes = [
+            models.Index(
+                fields=("timetable", "weekday", "session_number"),
+                name="weekly_tt_lookup_idx",
+            )
+        ]
+
+    def clean(self):
+        super().clean()
+        if (
+            self.timetable_id
+            and self.session_number
+            and self.session_number > self.timetable.sessions_per_day
+        ):
+            raise ValidationError(
+                "The session number is outside this timetable's configured range."
+            )
+
+    def __str__(self):
+        return (
+            f"{self.get_weekday_display()} · Session {self.session_number} · "
+            f"{self.title}"
+        )
+
+
+class DailyTimetableAllocation(models.Model):
+    plan = models.ForeignKey(
+        StudyPlan,
+        on_delete=models.CASCADE,
+        related_name="timetable_allocations",
+    )
+    recommendation = models.ForeignKey(
+        StudyRecommendation,
+        on_delete=models.CASCADE,
+        related_name="timetable_allocations",
+    )
+    session_number = models.PositiveSmallIntegerField()
+    allocated_minutes = models.PositiveSmallIntegerField()
+    position = models.PositiveSmallIntegerField(default=0)
+    created_at = models.DateTimeField(auto_now_add=True)
+
+    class Meta:
+        ordering = ("session_number", "position", "pk")
+        constraints = [
+            models.CheckConstraint(
+                condition=models.Q(session_number__gte=1),
+                name="daily_tt_session_positive",
+            ),
+            models.CheckConstraint(
+                condition=models.Q(
+                    allocated_minutes__gte=1,
+                    allocated_minutes__lte=60,
+                ),
+                name="daily_tt_minutes_range",
+            ),
+            models.UniqueConstraint(
+                fields=("plan", "session_number", "position"),
+                name="daily_tt_unique_position",
+            ),
+        ]
+        indexes = [
+            models.Index(
+                fields=("plan", "session_number", "position"),
+                name="daily_tt_plan_slot_idx",
+            )
+        ]
+
+    def clean(self):
+        super().clean()
+        if (
+            self.plan_id
+            and self.recommendation_id
+            and self.recommendation.plan_id != self.plan_id
+        ):
+            raise ValidationError(
+                "A timetable allocation must reference a recommendation from its plan."
+            )
+
+    def __str__(self):
+        return (
+            f"{self.plan.plan_date} · Session {self.session_number} · "
+            f"{self.recommendation.title}"
+        )
+
