+/* Navigation restructure: Today, Learn, Prepare and Interview */
+
+.app-navigation {
+    align-content: start;
+    gap: 0.4rem;
+    overflow-y: auto;
+}
+
+.app-nav-section {
+    display: grid;
+    gap: 0.15rem;
+}
+
+.app-nav-children {
+    display: grid;
+    gap: 0.05rem;
+    padding: 0.15rem 0 0.45rem 3.15rem;
+}
+
+.app-nav-children a {
+    padding: 0.35rem 0.4rem;
+    border-left: 1px solid var(--vc-border);
+    color: var(--vc-muted);
+    font-size: 0.78rem;
+    font-weight: 700;
+    text-decoration: none;
+}
+
+.app-nav-children a:hover,
+.app-nav-children a.is-active {
+    border-left-color: var(--vc-burgundy);
+    color: var(--vc-burgundy-dark);
+}
+
+.app-sidebar-footer {
+    position: relative;
+    display: block;
+}
+
+.app-account-menu {
+    position: relative;
+}
+
+.app-account-menu > summary {
+    list-style: none;
+}
+
+.app-account-menu > summary::-webkit-details-marker {
+    display: none;
+}
+
+.app-account-trigger {
+    display: grid;
+    width: 100%;
+    grid-template-columns: 2.3rem minmax(0, 1fr) 1rem;
+    gap: 0.75rem;
+    align-items: center;
+    padding: 0;
+    color: var(--vc-ink);
+    cursor: pointer;
+}
+
+.app-account-trigger:hover .app-account-copy strong {
+    color: var(--vc-burgundy-dark);
+}
+
+.app-account-chevron {
+    width: 1rem;
+    height: 1rem;
+    fill: none;
+    stroke: currentColor;
+    stroke-linecap: round;
+    stroke-linejoin: round;
+    stroke-width: 1.8;
+    transition: transform 140ms ease;
+}
+
+.app-account-menu[open] .app-account-chevron {
+    transform: rotate(180deg);
+}
+
+.app-account-panel {
+    display: grid;
+    min-width: 14rem;
+    border: 1px solid var(--vc-border);
+    background: var(--vc-paper-strong);
+    box-shadow: 0 14px 32px rgba(33, 29, 27, 0.16);
+}
+
+.app-account-menu-desktop .app-account-panel {
+    position: absolute;
+    right: 0;
+    bottom: calc(100% + 0.65rem);
+    left: 0;
+}
+
+.app-account-panel-heading {
+    display: grid;
+    gap: 0.15rem;
+    padding: 0.85rem 1rem;
+    border-bottom: 1px solid var(--vc-border);
+}
+
+.app-account-panel-heading span {
+    overflow: hidden;
+    color: var(--vc-muted);
+    font-size: 0.72rem;
+    text-overflow: ellipsis;
+    white-space: nowrap;
+}
+
+.app-account-panel > a,
+.app-account-panel > .app-account-disabled,
+.app-account-panel form button {
+    width: 100%;
+    padding: 0.75rem 1rem;
+    border: 0;
+    border-bottom: 1px solid var(--vc-border);
+    color: var(--vc-ink);
+    background: transparent;
+    font: inherit;
+    font-size: 0.84rem;
+    font-weight: 700;
+    text-align: left;
+    text-decoration: none;
+}
+
+.app-account-panel > a:hover,
+.app-account-panel form button:hover {
+    color: var(--vc-burgundy-dark);
+    background: #f3eee7;
+}
+
+.app-account-disabled {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    gap: 0.75rem;
+    color: var(--vc-muted) !important;
+    cursor: not-allowed;
+}
+
+.app-account-disabled small {
+    font-size: 0.65rem;
+    font-weight: 700;
+    text-transform: uppercase;
+}
+
+.app-account-panel form {
+    margin: 0;
+}
+
+.app-account-panel form button {
+    border-bottom: 0;
+    color: var(--vc-burgundy-dark);
+    cursor: pointer;
+}
+
+.section-hub-header,
+.section-hub-section,
+.section-hub-guidance {
+    width: min(100%, 80rem);
+    margin-inline: auto;
+}
+
+.section-hub-header {
+    padding-bottom: 1.8rem;
+    margin-bottom: 2rem;
+    border-bottom: 1px solid var(--vc-border);
+}
+
+.section-hub-header h1 {
+    max-width: 58rem;
+    margin: 0.3rem 0 0.8rem;
+    font-size: clamp(2.8rem, 7vw, 5.4rem);
+    line-height: 0.98;
+    letter-spacing: -0.045em;
+}
+
+.section-hub-header > p:last-child {
+    max-width: 50rem;
+    margin: 0;
+    color: var(--vc-muted);
+    font-size: 1.02rem;
+    line-height: 1.7;
+}
+
+.section-hub-section {
+    margin-top: 3rem;
+}
+
+.section-hub-section-heading {
+    padding-bottom: 1rem;
+    border-bottom: 2px solid var(--vc-ink);
+}
+
+.section-hub-section-heading h2 {
+    margin: 0.2rem 0 0;
+    font-size: clamp(1.6rem, 3vw, 2.35rem);
+}
+
+.section-hub-grid {
+    display: grid;
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+    gap: 1rem;
+    width: min(100%, 80rem);
+    margin-inline: auto;
+}
+
+.section-hub-grid-three {
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+}
+
+.section-hub-card {
+    display: flex;
+    min-height: 15rem;
+    flex-direction: column;
+    padding: 1.5rem;
+    border: 1px solid var(--vc-border);
+    color: var(--vc-ink);
+    background: var(--vc-paper);
+    text-decoration: none;
+    transition: border-color 140ms ease, transform 140ms ease;
+}
+
+.section-hub-card:hover {
+    transform: translateY(-2px);
+    border-color: var(--vc-burgundy);
+}
+
+.section-hub-card-featured {
+    border-top: 4px solid var(--vc-burgundy);
+}
+
+.section-hub-kicker {
+    color: var(--vc-burgundy);
+    font-size: 0.7rem;
+    font-weight: 800;
+    letter-spacing: 0.1em;
+    text-transform: uppercase;
+}
+
+.section-hub-card h2,
+.section-hub-card h3 {
+    margin: 1rem 0 0.55rem;
+    font-size: 1.55rem;
+}
+
+.section-hub-card p {
+    margin: 0;
+    color: var(--vc-muted);
+    line-height: 1.65;
+}
+
+.section-hub-card strong {
+    margin-top: auto;
+    padding-top: 1.5rem;
+    color: var(--vc-burgundy-dark);
+    font-size: 0.82rem;
+}
+
+.section-hub-guidance {
+    padding: 1.5rem 0;
+    margin-top: 3rem;
+    border-block: 1px solid var(--vc-border);
+}
+
+.section-hub-guidance h2 {
+    margin: 0.25rem 0 0.65rem;
+}
+
+.section-hub-guidance > p:not(.eyebrow) {
+    max-width: 50rem;
+    color: var(--vc-muted);
+}
+
+.section-hub-text-link {
+    display: inline-block;
+    margin-top: 0.5rem;
+    font-weight: 750;
+    text-decoration: none;
+}
+
+.section-hub-text-link:hover {
+    text-decoration: underline;
+}
+
+@media (max-width: 64rem) and (min-width: 48.01rem) {
+    .app-nav-children {
+        padding-left: 2.8rem;
+    }
+}
+
+@media (max-width: 48rem) {
+    .app-mobile-header-actions {
+        position: relative;
+    }
+
+    .app-account-menu-mobile .app-account-trigger {
+        display: block;
+        padding: 0;
+    }
+
+    .app-account-menu-mobile .app-account-panel {
+        position: fixed;
+        top: 3.4rem;
+        right: 0.75rem;
+        width: min(19rem, calc(100vw - 1.5rem));
+        z-index: 60;
+    }
+
+    .app-mobile-navigation {
+        grid-template-columns: repeat(4, minmax(0, 1fr));
+    }
+
+    .section-hub-header h1 {
+        font-size: clamp(2.65rem, 13vw, 4.3rem);
+    }
+
+    .section-hub-grid,
+    .section-hub-grid-three {
+        grid-template-columns: 1fr;
+    }
+
+    .section-hub-card {
+        min-height: 13rem;
+    }
+}
diff --git a/apps/core/tests/test_navigation_hubs.py b/apps/core/tests/test_navigation_hubs.py
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/apps/core/tests/test_navigation_hubs.py
@@ -0,0 +1,67 @@
+import pytest
+from django.urls import reverse
+
+pytestmark = pytest.mark.django_db
+
+
+@pytest.mark.parametrize("url_name", ["learn", "prepare", "interview"])
+def test_section_hubs_require_authentication(client, url_name):
+    response = client.get(reverse(url_name))
+
+    assert response.status_code == 302
+    assert response.url.startswith(reverse("login"))
+
+
+@pytest.mark.parametrize(
+    ("url_name", "heading", "linked_route"),
+    [
+        ("learn", "Build knowledge with structure.", "roadmaps:list"),
+        ("prepare", "Turn knowledge into interview-ready answers.", "questions:list"),
+        ("interview", "Prepare for the actual process.", "goals:list"),
+    ],
+)
+def test_section_hubs_expose_clear_next_actions(
+    client,
+    user,
+    url_name,
+    heading,
+    linked_route,
+):
+    client.force_login(user)
+
+    response = client.get(reverse(url_name))
+    html = response.content.decode()
+
+    assert response.status_code == 200
+    assert heading in html
+    assert f'href="{reverse(linked_route)}"' in html
+
+
+def test_authenticated_navigation_uses_four_user_intent_sections(client, user):
+    client.force_login(user)
+
+    response = client.get(reverse("dashboard"))
+    html = response.content.decode()
+
+    assert response.status_code == 200
+    assert html.count('class="mobile-nav-link') == 4
+    assert "<span>Today</span>" in html
+    assert "<span>Learn</span>" in html
+    assert "<span>Prepare</span>" in html
+    assert "<span>Interview</span>" in html
+    assert "<span>More</span>" not in html
+    assert "<span>Review</span>" not in html
+
+
+def test_account_menu_contains_secondary_actions(client, user):
+    client.force_login(user)
+
+    response = client.get(reverse("learn"))
+    html = response.content.decode()
+
+    assert response.status_code == 200
+    assert "Open account menu" in html
+    assert f'href="{reverse("questions:import_history")}"' in html
+    assert "Help centre" in html
+    assert "Settings" in html
+    assert "Log out" in html
