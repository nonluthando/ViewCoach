+        views.story_delete,
+        name="story_delete",
+    ),
+    path(
+        "topics/<int:topic_id>/profile/",
+        views.topic_profile_save,
+        name="topic_profile_save",
+    ),
+    path(
+        "topics/<int:topic_id>/links/",
+        views.topic_evidence_link,
+        name="topic_link",
+    ),
+    path(
+        "topics/<int:topic_id>/links/<int:link_id>/delete/",
+        views.topic_evidence_unlink,
+        name="topic_unlink",
+    ),
+    path(
