+{% extends "base.html" %}
+
+{% block title %}Prepare | ViewCoach{% endblock %}
+
+{% block content %}
+<section class="section-hub-header">
+    <p class="eyebrow">Prepare</p>
+    <h1>Turn knowledge into interview-ready answers.</h1>
+    <p>Practise recall, technical reasoning, behavioural evidence, project explanations and repository work without mixing everything into one queue.</p>
+</section>
+
+<section class="section-hub-section" aria-labelledby="prepare-practice-heading">
+    <div class="section-hub-section-heading">
+        <p class="eyebrow">Questions and recall</p>
