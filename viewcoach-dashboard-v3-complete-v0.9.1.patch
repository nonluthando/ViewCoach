+    background: linear-gradient(135deg, #fff9f4, #f6e9df);
+}
+
+.dashboard-v3-quote > span {
+    color: var(--d3-copper);
+    font-family: Georgia, serif;
+    font-size: 2.1rem;
+    line-height: 1;
+}
+
+.dashboard-v3-quote p {
+    position: relative;
+    z-index: 1;
+    margin: 0.2rem 0 0;
+    font-size: 0.9rem;
+    font-weight: 700;
+    line-height: 1.45;
+}
+
+.dashboard-v3-quote-mountain {
+    position: absolute;
+    right: -0.5rem;
+    bottom: -1.2rem;
+    color: #c2aca0;
+    font-size: 7rem;
+    opacity: 0.45;
+}
+
+.dashboard-v3-empty {
+    display: grid;
+    gap: 0.4rem;
+    min-height: 8.5rem;
+    align-content: center;
+    padding: 1rem 0;
+}
+
+.dashboard-v3-empty-compact {
+    min-height: 5rem;
+}
+
+.dashboard-v3-empty strong { font-size: 0.76rem; }
+.dashboard-v3-empty p { margin: 0; color: var(--d3-muted); font-size: 0.66rem; line-height: 1.5; }
+.dashboard-v3-empty a { color: var(--d3-copper-dark); font-size: 0.66rem; font-weight: 750; text-decoration: none; }
+
+.dashboard-v3 .sr-only {
+    position: absolute;
+    width: 1px;
+    height: 1px;
+    padding: 0;
+    overflow: hidden;
+    clip: rect(0, 0, 0, 0);
+    white-space: nowrap;
+    border: 0;
+}
+
+@media (max-width: 82rem) {
+    .dashboard-v3-layout {
+        grid-template-columns: repeat(2, minmax(0, 1fr));
+        grid-template-areas:
+            "roadmaps journey"
+            "plan evidence"
+            "plan resources"
+            "rail rail";
+    }
+
+    .dashboard-v3-rail {
+        grid-template-columns: repeat(3, minmax(0, 1fr));
+    }
+
+    .dashboard-v3-quote {
+        grid-column: 1 / -1;
+    }
+}
+
+@media (max-width: 64rem) {
+    .dashboard-v3-hero {
+        grid-template-columns: auto minmax(0, 1fr);
+    }
+
+    .dashboard-v3-mountain {
+        display: none;
+    }
+
+    .dashboard-v3-metrics {
+        grid-template-columns: repeat(2, minmax(0, 1fr));
+    }
+
+    .dashboard-v3-rail {
+        grid-template-columns: repeat(2, minmax(0, 1fr));
+    }
+}
+
+@media (max-width: 48rem) {
+    .dashboard-v3-page .app-main {
+        padding: 1rem 1rem 6.25rem;
+    }
+
+    .dashboard-v3-main {
+        padding: 1rem;
+    }
+
+    .dashboard-v3-header {
+        align-items: center;
+    }
+
+    .dashboard-v3-header h1 {
+        font-size: 2rem;
+    }
+
+    .dashboard-v3-hero {
+        grid-template-columns: 1fr;
+        text-align: left;
+    }
+
+    .dashboard-v3-plan-ring {
+        width: 6.25rem;
+        height: 6.25rem;
+    }
+
+    .dashboard-v3-hero-actions {
+        align-items: stretch;
+        flex-direction: column;
+    }
+
+    .dashboard-v3-hero-actions .button {
+        width: 100%;
+        min-height: 2.75rem;
+    }
+
+    .dashboard-v3-layout {
+        grid-template-columns: 1fr;
+        grid-template-areas:
+            "plan"
+            "journey"
+            "roadmaps"
+            "evidence"
+            "resources"
+            "rail";
+    }
+
+    .dashboard-v3-rail {
+        grid-template-columns: 1fr;
+    }
+
+    .dashboard-v3-plan-item {
+        grid-template-columns: auto auto minmax(0, 1fr) auto;
+        padding: 0.55rem 0;
+    }
+
+    .dashboard-v3-plan-duration {
+        display: none;
+    }
+
+    .dashboard-v3-plan-action,
+    .dashboard-v3-plan-done {
+        grid-column: 4;
+    }
+}
+
+@media (max-width: 23rem) {
+    .dashboard-v3-metrics {
+        grid-template-columns: 1fr;
+    }
+
+    .dashboard-v3-header > div:first-child > p:last-child {
+        display: none;
+    }
+
+    .dashboard-v3-journey-status {
+        display: none;
+    }
+}
+
+@media (prefers-reduced-motion: reduce) {
+    .dashboard-v3 *,
+    .dashboard-v3 *::before,
+    .dashboard-v3 *::after {
+        scroll-behavior: auto !important;
+        transition-duration: 0.01ms !important;
+        animation-duration: 0.01ms !important;
+    }
+}
