+.proofloop-path li {
+    position: relative;
+    z-index: 1;
+    display: grid;
+    grid-template-columns: 1.1rem 1fr auto;
+    gap: 0.8rem;
+    align-items: center;
+    padding: 0.72rem 0;
+}
+
+.proofloop-path li > span {
+    width: 1.1rem;
+    height: 1.1rem;
+    border: 0.18rem solid #71817c;
+    border-radius: 50%;
+    background: var(--proofloop-ink);
+}
+
+.proofloop-path li.is-complete > span {
+    border-color: var(--proofloop-emerald);
+    background: var(--proofloop-emerald);
+}
+
+.proofloop-path li.is-current > span {
+    border-color: var(--proofloop-amber);
+    background: var(--proofloop-amber);
+    box-shadow: 0 0 0 0.25rem rgba(191, 123, 39, 0.16);
+}
+
+.proofloop-path strong,
+.proofloop-path small {
+    display: block;
+}
+
+.proofloop-path strong {
+    color: #ffffff;
+    font-size: 0.9rem;
+}
+
+.proofloop-path small {
+    margin-top: 0.12rem;
+    color: #9fb0aa;
+    font-size: 0.75rem;
+}
+
+.proofloop-path b {
+    color: #9fb0aa;
+    font-size: 0.68rem;
+    font-weight: 800;
+    letter-spacing: 0.05em;
+    text-transform: uppercase;
+}
+
+.proofloop-path .is-current b {
+    color: #e4b87c;
+}
+
+.proofloop-hero-panel > footer {
+    display: block;
+    margin-top: 1.35rem;
+    padding: 1rem;
+    border: 1px solid rgba(255, 255, 255, 0.11);
+    border-radius: var(--proofloop-radius);
+    background: rgba(255, 255, 255, 0.04);
+}
+
+.proofloop-layer-section,
+.proofloop-evidence-section {
+    padding-block: clamp(4rem, 8vw, 7rem);
+    border-top: 1px solid var(--proofloop-border);
+}
+
+.proofloop-layer-section > header {
+    max-width: 47rem;
+    margin-bottom: 2rem;
+}
+
+.proofloop-layer-section h2,
+.proofloop-evidence-section h2 {
+    margin: 0.45rem 0 0.8rem;
+    font-size: clamp(2rem, 4vw, 3.5rem);
+    line-height: 1.03;
+}
+
+.proofloop-layer-grid {
+    display: grid;
+    grid-template-columns: repeat(4, minmax(0, 1fr));
+    border: 1px solid var(--proofloop-border);
+    border-radius: 0.7rem;
+    overflow: hidden;
+}
+
+.proofloop-layer-grid article {
+    min-height: 17rem;
+    padding: 1.5rem;
+    background: var(--proofloop-surface);
+}
+
+.proofloop-layer-grid article + article {
+    border-left: 1px solid var(--proofloop-border);
+}
+
+.proofloop-layer-grid article > span {
+    color: var(--proofloop-emerald-dark);
+    font-size: 0.75rem;
+    font-weight: 900;
+}
+
+.proofloop-layer-grid h3 {
+    margin: 3.5rem 0 0.65rem;
+    font-size: 1.35rem;
+}
+
+.proofloop-layer-grid p {
+    color: var(--proofloop-muted);
+    font-size: 0.9rem;
+}
+
+.proofloop-layer-grid small {
+    display: block;
+    margin-top: 2rem;
+    color: var(--proofloop-emerald-dark);
+    font-weight: 800;
+}
+
+.proofloop-evidence-section {
+    display: grid;
+    grid-template-columns: minmax(0, 0.85fr) minmax(24rem, 1.15fr);
+    gap: clamp(2rem, 8vw, 7rem);
+    align-items: center;
+}
+
+.proofloop-evidence-section > div:first-child > p:not(.eyebrow) {
+    color: var(--proofloop-muted);
+}
+
+.proofloop-evidence-section > div:first-child > a {
+    color: var(--proofloop-emerald-dark);
+    font-weight: 850;
+    text-decoration: none;
+}
+
+.proofloop-evidence-stack {
+    display: grid;
+    gap: 0.8rem;
+}
+
+.proofloop-evidence-stack article {
+    padding: 1.2rem 1.3rem;
+    border: 1px solid var(--proofloop-border);
+    border-left: 0.25rem solid var(--proofloop-emerald);
+    border-radius: var(--proofloop-radius);
+    background: var(--proofloop-surface);
+}
+
+.proofloop-evidence-stack article:nth-child(2) {
+    margin-left: 2rem;
+    border-left-color: var(--proofloop-amber);
+}
+
+.proofloop-evidence-stack article:nth-child(3) {
+    margin-left: 4rem;
+}
+
+.proofloop-evidence-stack span,
+.proofloop-evidence-stack small,
+.proofloop-evidence-stack strong {
+    display: block;
+}
+
+.proofloop-evidence-stack span {
+    color: var(--proofloop-emerald-dark);
+    font-size: 0.7rem;
+    font-weight: 850;
+    letter-spacing: 0.07em;
+    text-transform: uppercase;
+}
+
+.proofloop-evidence-stack strong {
+    margin: 0.35rem 0;
+    color: var(--proofloop-text);
+}
+
+.proofloop-evidence-stack small {
+    color: var(--proofloop-muted);
+}
+
+/* Public forms and case study */
+
+.public-body .form-card,
+.public-body .portfolio-problem-grid article,
+.public-body .portfolio-architecture-grid article,
+.public-body .portfolio-decision-grid article,
+.public-body .portfolio-demo-preview li {
+    color: var(--proofloop-text);
+    border-color: var(--proofloop-border);
+    border-radius: var(--proofloop-radius);
+    background: var(--proofloop-surface);
+    box-shadow: none;
+}
+
+.public-body input,
+.public-body textarea,
+.public-body select {
+    color: var(--proofloop-text);
+    border-color: var(--proofloop-border-strong);
+    border-radius: var(--proofloop-radius-small);
+    background: var(--proofloop-surface);
+}
+
+.public-body input:focus,
+.public-body textarea:focus,
+.public-body select:focus {
+    border-color: var(--proofloop-emerald);
+    outline: 2px solid rgba(31, 118, 89, 0.18);
+}
+
+.public-body .portfolio-home-proof,
+.public-body .portfolio-case-summary,
+.public-body .portfolio-case-cta,
+.public-body .portfolio-metric-strip {
+    color: #f4f8f5;
+    background: var(--proofloop-ink);
+    box-shadow: none;
+}
+
+.public-body .portfolio-case-summary dt,
+.public-body .portfolio-metric-strip span {
+    color: #b9c9c4;
+}
+
+.public-body .portfolio-flow article span {
+    color: #ffffff;
+    background: var(--proofloop-emerald);
+}
+
+.public-body .portfolio-case-section {
+    border-color: var(--proofloop-border);
+}
+
+.public-body .portfolio-demo-status {
+    color: var(--proofloop-amber-dark);
+    background: var(--proofloop-amber-soft);
+}
+
+/* Demo */
+
+.app-body .portfolio-demo-banner {
+    color: var(--proofloop-text);
+    border: 1px solid #dfc297;
+    border-radius: var(--proofloop-radius);
+    background: var(--proofloop-amber-soft);
+    box-shadow: none;
+}
+
+.app-body .portfolio-demo-banner-heading span {
+    color: var(--proofloop-amber-dark);
+}
+
+.app-body .portfolio-demo-banner nav a {
+    color: var(--proofloop-text);
+    border-color: #ddc9aa;
+    border-radius: var(--proofloop-radius-small);
+    background: rgba(255, 253, 248, 0.76);
+}
+
+.app-body .portfolio-demo-banner nav a.is-complete {
+    color: var(--proofloop-emerald-dark);
+    border-color: #9dbdac;
+    background: var(--proofloop-emerald-soft);
+}
+
+.app-body .portfolio-demo-guide-grid article,
+.app-body .portfolio-demo-control-panel {
+    border-color: var(--proofloop-border);
+    border-radius: var(--proofloop-radius);
+    background: var(--proofloop-surface);
+    box-shadow: none;
+}
+
+.app-body .portfolio-demo-guide-grid article.is-complete {
+    border-color: #9dbdac;
+    background: #f1f7f3;
+}
+
+.app-body .portfolio-demo-guide-progress {
+    color: #ffffff;
+    background: var(--proofloop-ink);
+    border-radius: var(--proofloop-radius);
+}
+
+.app-body .portfolio-demo-step-number,
+.app-body .portfolio-demo-guide-progress strong {
+    color: #9fcdb9;
+}
+
+/* Accessibility */
+
+.public-body :focus-visible,
+.app-body :focus-visible {
+    outline: 2px solid var(--proofloop-amber);
+    outline-offset: 3px;
+}
+
+@media (max-width: 64rem) {
+    .proofloop-hero {
+        grid-template-columns: 1fr;
+        min-height: auto;
+    }
+
+    .proofloop-hero-copy h1 {
+        max-width: 13ch;
+    }
+
+    .proofloop-hero-panel {
+        max-width: 46rem;
+    }
+
+    .proofloop-layer-grid {
+        grid-template-columns: repeat(2, minmax(0, 1fr));
+    }
+
+    .proofloop-layer-grid article:nth-child(3) {
+        border-left: 0;
+        border-top: 1px solid var(--proofloop-border);
+    }
+
+    .proofloop-layer-grid article:nth-child(4) {
+        border-top: 1px solid var(--proofloop-border);
+    }
+
+    .proofloop-evidence-section {
+        grid-template-columns: 1fr;
+    }
+}
+
+@media (max-width: 48rem) {
+    .public-body .site-header .nav {
+        min-height: 4rem;
+        gap: 0.7rem;
+    }
+
+    .public-body .site-header .nav-actions {
+        gap: 0.55rem;
+    }
+
+    .public-body .site-header .nav-actions > a {
+        font-size: 0.8rem;
+    }
+
+    .public-body .site-header .button-small {
+        min-height: 2.25rem;
+        padding: 0.45rem 0.65rem;
+    }
+
+    .proofloop-hero {
+        padding-top: 0.5rem;
+    }
+
+    .proofloop-hero-copy h1 {
+        font-size: clamp(2.7rem, 13vw, 4.4rem);
+    }
+
+    .proofloop-hero-signals {
+        grid-template-columns: 1fr;
+    }
+
+    .proofloop-hero-signals div + div {
+        padding-left: 0;
+        border-top: 1px solid var(--proofloop-border);
+        border-left: 0;
+    }
+
+    .proofloop-layer-grid {
+        grid-template-columns: 1fr;
+    }
+
+    .proofloop-layer-grid article + article {
+        border-top: 1px solid var(--proofloop-border);
+        border-left: 0;
+    }
+
+    .proofloop-layer-grid article {
+        min-height: auto;
+    }
+
+    .proofloop-layer-grid h3 {
+        margin-top: 2rem;
+    }
+
+    .proofloop-evidence-stack article:nth-child(2),
+    .proofloop-evidence-stack article:nth-child(3) {
+        margin-left: 0;
+    }
+
+    .app-body .portfolio-demo-banner nav {
+        grid-template-columns: repeat(2, minmax(0, 1fr));
+    }
+}
+
+@media (prefers-reduced-motion: reduce) {
+    *,
+    *::before,
+    *::after {
+        scroll-behavior: auto !important;
+        transition-duration: 0.01ms !important;
+        animation-duration: 0.01ms !important;
+        animation-iteration-count: 1 !important;
+    }
+}
