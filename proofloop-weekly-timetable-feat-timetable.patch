+def configured_timetable_for_user(*, user):
+    return WeeklyTimetable.objects.filter(
+        user=user,
+        sessions_per_day__gt=0,
+    ).first()
+
+
+def get_or_create_weekly_timetable(*, user):
+    timetable, _ = WeeklyTimetable.objects.get_or_create(
+        user=user,
+        defaults={"sessions_per_day": 0},
+    )
+    return timetable
+
+
+def timetable_blocks_for_date(*, timetable, plan_date):
+    return timetable.blocks.filter(
+        weekday=plan_date.weekday(),
+    ).order_by("session_number", "pk")
+
+
+def available_session_numbers(*, timetable, plan_date):
+    occupied = set(
+        timetable_blocks_for_date(
+            timetable=timetable,
+            plan_date=plan_date,
+        ).values_list("session_number", flat=True)
+    )
+    return tuple(
+        session_number
+        for session_number in timetable.session_numbers
+        if session_number not in occupied
+    )
+
+
+def _recommendation_key(recommendation):
+    return (
+        recommendation.kind,
+        recommendation.question_id,
+        recommendation.topic_id,
+        recommendation.action_path,
+        recommendation.title,
+    )
+
+
+def _completed_recommendations(plan):
+    return {
+        _recommendation_key(recommendation): recommendation.completed_at
+        for recommendation in plan.recommendations.filter(
+            completed_at__isnull=False,
+        )
+    }
+
+
+def _restore_completed_recommendations(*, plan, completed):
+    updates = []
+    for recommendation in plan.recommendations.all():
+        completed_at = completed.get(_recommendation_key(recommendation))
+        if completed_at is not None:
+            recommendation.completed_at = completed_at
+            updates.append(recommendation)
+    if updates:
+        StudyRecommendation.objects.bulk_update(
+            updates,
+            ["completed_at"],
+        )
+
+
+@transaction.atomic
+def allocate_plan_recommendations(*, plan, session_numbers):
+    ordered_sessions = tuple(sorted(set(session_numbers)))
+    plan.timetable_allocations.all().delete()
+
+    if not ordered_sessions:
+        return tuple()
+
+    allocations = []
+    session_index = 0
+    remaining_session_minutes = SESSION_MINUTES
+    position_by_session = defaultdict(int)
+
+    for recommendation in plan.recommendations.order_by(
+        "position",
+        "-priority_score",
+        "pk",
+    ):
+        remaining_recommendation_minutes = recommendation.estimated_minutes
+
+        while remaining_recommendation_minutes > 0:
+            if session_index >= len(ordered_sessions):
+                raise ValueError(
+                    "The generated plan exceeds the available timetable capacity."
+                )
+
+            session_number = ordered_sessions[session_index]
+            allocated_minutes = min(
+                remaining_recommendation_minutes,
+                remaining_session_minutes,
+            )
+            position_by_session[session_number] += 1
+            allocations.append(
+                DailyTimetableAllocation(
+                    plan=plan,
+                    recommendation=recommendation,
+                    session_number=session_number,
+                    allocated_minutes=allocated_minutes,
+                    position=position_by_session[session_number],
+                )
+            )
+            remaining_recommendation_minutes -= allocated_minutes
+            remaining_session_minutes -= allocated_minutes
+
+            if remaining_session_minutes == 0:
+                session_index += 1
+                remaining_session_minutes = SESSION_MINUTES
+
+    DailyTimetableAllocation.objects.bulk_create(allocations)
+    return tuple(allocations)
+
+
+@transaction.atomic
+def _empty_timetable_plan(*, user, plan_date, current_time):
+    plan, _ = StudyPlan.objects.select_for_update().get_or_create(
+        user=user,
+        plan_date=plan_date,
+        defaults={
+            "time_budget_minutes": 0,
+            "generated_at": current_time,
+        },
+    )
+    if plan.sessions.filter(ended_at__isnull=True).exists():
+        return plan
+
+    plan.recommendations.all().delete()
+    plan.timetable_allocations.all().delete()
+    plan.time_budget_minutes = 0
+    plan.status = StudyPlan.Status.ACTIVE
+    plan.selection_status = StudyPlan.SelectionStatus.FALLBACK
+    plan.selection_objective = None
+    plan.selection_best_bound = None
+    plan.selection_solve_time_ms = None
+    plan.generated_at = current_time
+    plan.save(
+        update_fields=[
+            "time_budget_minutes",
+            "status",
+            "selection_status",
+            "selection_objective",
+            "selection_best_bound",
+            "selection_solve_time_ms",
+            "generated_at",
+            "updated_at",
+        ]
+    )
+    return plan
+
+
+@transaction.atomic
+def generate_daily_plan_from_timetable(
+    *,
+    user,
+    timetable,
+    now=None,
+    force=False,
+):
+    current_time = now or timezone.now()
+    plan_date = timezone.localdate(current_time)
+    open_sessions = available_session_numbers(
+        timetable=timetable,
+        plan_date=plan_date,
+    )
+    time_budget_minutes = len(open_sessions) * SESSION_MINUTES
+    existing_plan = (
+        StudyPlan.objects.select_for_update()
+        .filter(user=user, plan_date=plan_date)
+        .first()
+    )
+
+    if (
+        existing_plan is not None
+        and existing_plan.sessions.filter(ended_at__isnull=True).exists()
+        and (
+            force
+            or existing_plan.time_budget_minutes != time_budget_minutes
+        )
+    ):
+        return existing_plan
+
+    completed = (
+        _completed_recommendations(existing_plan)
+        if existing_plan is not None and force
+        else {}
+    )
+
+    if time_budget_minutes == 0:
+        return _empty_timetable_plan(
+            user=user,
+            plan_date=plan_date,
+            current_time=current_time,
+        )
+
+    plan = _generate_daily_plan_core(
+        user=user,
+        time_budget_minutes=time_budget_minutes,
+        now=current_time,
+        force=(
+            force
+            or (
+                existing_plan is not None
+                and existing_plan.time_budget_minutes != time_budget_minutes
+            )
+        ),
+    )
+    _restore_completed_recommendations(
+        plan=plan,
+        completed=completed,
+    )
+    allocate_plan_recommendations(
+        plan=plan,
+        session_numbers=open_sessions,
+    )
+    return plan
+
+
+def generate_daily_plan(
+    *,
+    user,
+    time_budget_minutes=DEFAULT_TIME_BUDGET_MINUTES,
+    now=None,
+    force=False,
+):
+    timetable = configured_timetable_for_user(user=user)
+    if timetable is not None:
+        return generate_daily_plan_from_timetable(
+            user=user,
+            timetable=timetable,
+            now=now,
+            force=force,
+        )
+    return _generate_daily_plan_core(
+        user=user,
+        time_budget_minutes=time_budget_minutes,
+        now=now,
+        force=force,
+    )
+
+
+def timetable_day_summary(*, timetable, plan):
+    fixed_blocks = {
+        block.session_number: block
+        for block in timetable_blocks_for_date(
+            timetable=timetable,
+            plan_date=plan.plan_date,
+        )
+    }
+    allocations_by_session = defaultdict(list)
+    for allocation in plan.timetable_allocations.select_related(
+        "recommendation",
+        "recommendation__question",
+        "recommendation__topic__section__roadmap",
+    ):
+        allocations_by_session[allocation.session_number].append(allocation)
+
+    sessions = []
+    for session_number in timetable.session_numbers:
+        fixed_block = fixed_blocks.get(session_number)
+        allocations = tuple(
+            allocations_by_session.get(session_number, ())
+        )
+        used_minutes = sum(
+            allocation.allocated_minutes for allocation in allocations
+        )
+        sessions.append(
+            {
+                "number": session_number,
+                "fixed_block": fixed_block,
+                "allocations": allocations,
+                "used_minutes": used_minutes,
+                "remaining_minutes": (
+                    0 if fixed_block else SESSION_MINUTES - used_minutes
+                ),
+                "is_available": fixed_block is None,
+            }
+        )
+
+    return {
+        "timetable_sessions": tuple(sessions),
+        "available_session_count": sum(
+            session["is_available"] for session in sessions
+        ),
+        "fixed_block_count": len(fixed_blocks),
+    }
+
